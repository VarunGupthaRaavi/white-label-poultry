{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["developer_panel/src/*"]
    }
  },
  "include": [
    "developer_panel/src/**/*",
    "developer_panel/next-env.d.ts",
    "functions/src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/.next",
    "functions/lib"
  ]
}
