# ==============================================================================
# White-Label Commerce Platform - Environment Template
# DO NOT COMMIT PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# Control Plane Firebase Configuration (Platform Project)
FIREBASE_PROJECT_ID=poultry-platform-control
FIREBASE_API_KEY=AIzaSyExampleKeyForLocalDevOnly
FIREBASE_AUTH_DOMAIN=poultry-platform-control.firebaseapp.com
FIREBASE_STORAGE_BUCKET=poultry-platform-control.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Firebase Local Emulator Suite Ports
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# Platform Operations & Default Region
PLATFORM_DEFAULT_REGION=us-central1
DEFAULT_LOCALE=en_US
DEFAULT_CURRENCY=USD
