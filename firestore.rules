rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION PREDICATES
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformDeveloper() {
      return isAuthenticated() && (
        request.auth.token.role == 'developer' ||
        request.auth.token.role == 'super_admin'
      );
    }

    function isClientAdmin(tenantId) {
      return isAuthenticated() && 
             request.auth.token.tenantId == tenantId && 
             (request.auth.token.role == 'client_admin' || isPlatformDeveloper());
    }

    function isTenantUser(tenantId) {
      return isAuthenticated() && 
             (request.auth.token.tenantId == tenantId || isPlatformDeveloper());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Prevents privilege escalation: cannot alter immutable fields
    function notUpdatingField(fieldName) {
      return !(fieldName in request.resource.data) || 
             request.resource.data[fieldName] == resource.data[fieldName];
    }

    // =========================================================================
    // CONTROL PLANE RULES (Platform Infrastructure)
    // =========================================================================
    match /control_plane/{version} {

      // Platform Developers registry
      match /platform_admins/{adminUid} {
        allow read: if isPlatformDeveloper() || isOwner(adminUid);
        allow write: if isPlatformDeveloper();
      }

      // Tenant Registry: Only Platform Developers can mutate tenants
      match /tenants/{tenantId} {
        allow read: if isPlatformDeveloper() || isTenantUser(tenantId);
        allow write: if isPlatformDeveloper();
      }

      // Branding: Publicly readable for dynamic runtime Flutter/Web theme loading
      match /branding/{tenantId} {
        allow read: if true;
        allow write: if isPlatformDeveloper() || isClientAdmin(tenantId);
      }

      // Feature Entitlements: Readable by tenant users; ONLY Platform Developers can approve/mutate
      match /entitlements/{tenantId} {
        allow read: if isPlatformDeveloper() || isTenantUser(tenantId);
        allow write: if isPlatformDeveloper(); // Strictly no self-approval!
      }

      // Entitlement Requests submitted by Client Admins for Developer review
      match /entitlement_requests/{requestId} {
        allow read: if isPlatformDeveloper() || isTenantUser(resource.data.tenantId);
        allow create: if isClientAdmin(request.resource.data.tenantId);
        allow update, delete: if isPlatformDeveloper();
      }

      // Deployment Metadata & Infrastructure References
      match /deployments/{tenantId} {
        allow read, write: if isPlatformDeveloper();
      }

      // Control Plane Audit Logs: Append-only; IMMUTABLE
      match /audit_logs/{logId} {
        allow read: if isPlatformDeveloper();
        allow create: if isPlatformDeveloper();
        allow update, delete: if false; // Strict audit integrity
      }

      // Platform Health & Aggregated Telemetry
      match /platform_metrics/{metricId} {
        allow read: if isPlatformDeveloper();
        allow write: if isPlatformDeveloper();
      }
    }

    // =========================================================================
    // TENANT DATA PLANE RULES (Shared Multi-Tenant Mode & Data Scopes)
    // =========================================================================
    match /tenants/{tenantId} {

      // User Profiles (Customers, Staff, Admins)
      match /users/{userId} {
        allow read: if isPlatformDeveloper() || isTenantUser(tenantId);
        allow create: if isAuthenticated() && 
                         request.auth.uid == userId && 
                         request.resource.data.role == 'customer';
        // Prevents privilege escalation: cannot self-grant admin roles or change tenantId
        allow update: if isPlatformDeveloper() || 
                         isClientAdmin(tenantId) || 
                         (isOwner(userId) && 
                          notUpdatingField('role') && 
                          notUpdatingField('tenantId') &&
                          notUpdatingField('status'));
        allow delete: if isPlatformDeveloper() || isClientAdmin(tenantId);
      }

      // Poultry Marketplace Products (Live birds, dressed meat, eggs)
      match /products/{productId} {
        allow read: if resource.data.status == 'active' || 
                       isTenantUser(tenantId) || 
                       isPlatformDeveloper();
        allow create: if isPlatformDeveloper() || 
                         isClientAdmin(tenantId) || 
                         (isTenantUser(tenantId) && request.auth.token.role == 'seller');
        // Sellers can only update price/stock for their OWN products, CANNOT self-approve status
        allow update: if isPlatformDeveloper() || 
                         isClientAdmin(tenantId) || 
                         (isTenantUser(tenantId) && 
                          request.auth.token.role == 'seller' && 
                          resource.data.sellerId == request.auth.uid &&
                          notUpdatingField('status') && // Seller cannot change status to active
                          notUpdatingField('tenantId') &&
                          notUpdatingField('sellerId'));
        allow delete: if isPlatformDeveloper() || isClientAdmin(tenantId);
      }

      // Poultry Batches & Inventory
      match /inventory/{batchId} {
        allow read: if isTenantUser(tenantId) || isPlatformDeveloper();
        allow write: if isPlatformDeveloper() || 
                        isClientAdmin(tenantId) || 
                        (isTenantUser(tenantId) && request.auth.token.role == 'seller');
      }

      // Customer Orders & Batch Fulfillment State Machine
      match /orders/{orderId} {
        allow read: if isPlatformDeveloper() || 
                       isClientAdmin(tenantId) || 
                       (isTenantUser(tenantId) && (
                         resource.data.customerId == request.auth.uid ||
                         resource.data.sellerId == request.auth.uid
                       ));
        allow create: if isTenantUser(tenantId) && 
                         request.resource.data.customerId == request.auth.uid &&
                         request.resource.data.orderStatus == 'pending';
        
        // Strict Order Update Boundary:
        // 1. Client Admin can advance any valid transition
        // 2. Sellers can ONLY advance permitted fulfillment transitions: 'preparing' or 'ready_for_dispatch'
        //    and cannot alter items, paymentStatus, or totalAmount!
        // 3. Customers can only request cancellation while pending
        allow update: if isPlatformDeveloper() || 
                         isClientAdmin(tenantId) || 
                         (isTenantUser(tenantId) && 
                          request.auth.token.role == 'seller' && 
                          resource.data.sellerId == request.auth.uid &&
                          (request.resource.data.orderStatus == 'preparing' || 
                           request.resource.data.orderStatus == 'ready_for_dispatch') &&
                          notUpdatingField('totalAmount') &&
                          notUpdatingField('paymentStatus') &&
                          notUpdatingField('items') &&
                          notUpdatingField('sellerId') &&
                          notUpdatingField('customerId')) ||
                         (isTenantUser(tenantId) && 
                          resource.data.customerId == request.auth.uid &&
                          resource.data.orderStatus == 'pending' &&
                          request.resource.data.orderStatus == 'cancelled' &&
                          notUpdatingField('totalAmount') &&
                          notUpdatingField('items'));
        allow delete: if isPlatformDeveloper();
      }

      // Seller / Farmer KYC Profiles
      match /sellers/{sellerId} {
        allow read: if isTenantUser(tenantId) || isPlatformDeveloper();
        allow create: if isTenantUser(tenantId) && 
                         (isClientAdmin(tenantId) || request.auth.uid == sellerId);
        // Sellers CANNOT approve themselves or edit commission rate!
        allow update: if isPlatformDeveloper() || 
                         isClientAdmin(tenantId) || 
                         (isTenantUser(tenantId) && 
                          request.auth.uid == sellerId &&
                          notUpdatingField('status') && // Self-approval blocked
                          notUpdatingField('commissionRatePercent') &&
                          notUpdatingField('reviewedAt') &&
                          notUpdatingField('reviewedBy') &&
                          notUpdatingField('tenantId'));
        allow delete: if isPlatformDeveloper() || isClientAdmin(tenantId);
      }

      // Tenant-level Immutable Audit Trail Logs
      match /audit_logs/{logId} {
        allow read: if isClientAdmin(tenantId) || isPlatformDeveloper();
        allow create: if isClientAdmin(tenantId) || isPlatformDeveloper();
        allow update, delete: if false; // Strict audit immutability
      }

      // Coupons & Promotions (Requires module entitlement)
      match /coupons/{couponId} {
        allow read: if isTenantUser(tenantId);
        allow write: if isClientAdmin(tenantId);
      }

      // Reviews & Moderation
      match /reviews/{reviewId} {
        allow read: if resource.data.status == 'published' || isClientAdmin(tenantId);
        allow create: if isTenantUser(tenantId) && request.auth.uid == request.resource.data.customerId;
        allow update, delete: if isClientAdmin(tenantId);
      }

      // Tenant Operational Settings
      match /settings/operational {
        allow read: if isTenantUser(tenantId);
        allow write: if isClientAdmin(tenantId);
      }
    }
  }
}
